[node name="VaultCode" type="Area3D" parent="Gameplay" unique_id=2073754890]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, 5.9, 1.34, 11.5)
script = ExtResource("38_0e4st")
instruction = true
document_id = &"k17_VaultCode"
title = "Chỉ dẫn kho B1"
text = "Kho B1 dùng bốn chữ số. Đọc các ô trong bảng ca trực theo thứ tự A → C → B → D. Bảng đối chiếu ở điểm chuẩn bị khu hồ sơ. Thẻ và checkpoint phải hợp lệ trước khi xác nhận mã."
show_marker = true

[node name="DutyTable" type="Area3D" parent="Gameplay" unique_id=178187525]
transform = Transform3D(-1, 0, -8.742278e-08, 0, 1, 0, 8.742278e-08, 0, -1, 8.85, 1.4, -18.45)
script = ExtResource("38_0e4st")
document_id = &"k17_DutyTable"
title = "Bảng ca trực"
text = "Đối chiếu ca trực: A = 4; B = 2; C = 8; D = 7. Thứ tự nhập do ban chỉ huy quy định trong chỉ dẫn kho B1. Nhập sai ba lần: khóa tạm 20 giây và báo động cục bộ."
show_marker = true

[node name="PowerMemo" type="Area3D" parent="Gameplay" unique_id=171294215]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 42.85, 1.4, 1.7)
script = ExtResource("38_0e4st")
document_id = &"k17_PowerMemo"
title = "Nguồn dự phòng và đường rút"
text = "Công tắc trạm điện cắt nguồn camera chính. Phá niêm phong hồ sơ khởi động nguồn dự phòng sau 15 giây. Cổng sân đóng ở giây 90. Chuẩn bị chốt cửa hậu để mở nhanh; nếu chưa chuẩn bị phải giữ E tám giây. Lấy tài liệu xong mới bắt đầu 120 giây.

TÙY CHỌN / PHÁ HOẠI: tủ tình báo dự phòng nằm cạnh bàn dụng cụ trong xưởng phía nam trạm điện. Sau khi lấy hồ sơ, giữ E 5 giây tại mặt tủ để đặt thiết bị đã được cấp. Không chiếm ô đồ, không cộng giờ. Thiết bị chỉ kích hoạt khi đã rút tới tập kết an toàn; có thể bỏ qua để ưu tiên hồ sơ."
show_marker = true

