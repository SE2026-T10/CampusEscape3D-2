document_id = &"k17_PowerMemo"
title = "Nguồn dự phòng và đường rút"
text = "Công tắc trạm điện cắt nguồn camera chính. Phá niêm phong hồ sơ khởi động nguồn dự phòng sau 15 giây. Cổng sân đóng ở giây 90. Chuẩn bị chốt cửa hậu để mở nhanh; nếu chưa chuẩn bị phải giữ E tám giây. Lấy tài liệu xong mới bắt đầu 120 giây."
show_marker = true

