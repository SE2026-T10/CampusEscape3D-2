script = ExtResource("34_65tg2")
document_id = &"k17_DutyTable"
title = "Bảng ca trực"
text = "Đối chiếu ca trực: A = 4; B = 2; C = 8; D = 7. Thứ tự nhập do ban chỉ huy quy định trong chỉ dẫn kho B1. Nhập sai ba lần: khóa tạm 20 giây và báo động cục bộ."
show_marker = true

[node name="PowerMemo" type="Area3D" parent="Gameplay" unique_id=1068541499]
