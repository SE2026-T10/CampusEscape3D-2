title = "Chỉ dẫn kho B1"
text = "Kho B1 dùng bốn chữ số. Đọc các ô trong bảng ca trực theo thứ tự A → C → B → D. Bảng đối chiếu ở điểm chuẩn bị khu hồ sơ. Thẻ và checkpoint phải hợp lệ trước khi xác nhận mã."
show_marker = true

[node name="DutyTable" type="Area3D" parent="Gameplay" unique_id=672262911]
