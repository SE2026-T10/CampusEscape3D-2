extends SceneTree

## Development tool: checks the Expanded Library's lights against what the
## Compatibility renderer can draw, and how evenly they light the guards' routes.
##
##   godot --headless --path . --script res://tools/expanded/light_report.gd -- --out=docs/expanded/v4/lighting.md
##
## The Compatibility renderer (this project's) draws at most
##   - rendering/limits/opengl/max_renderable_lights (32) positional lights in a
##     frame: a light counts when its range touches the view frustum (walls don't
##     hide it) and it is not faded out by distance (a light with distance fade
##     takes no slot beyond its fade distance); beyond the limit, lights are
##     dropped in no particular order;
##   - rendering/limits/opengl/max_lights_per_object (8) lights on one mesh:
##     beyond that, the mesh ignores the rest.
## So the report gives:
##   1. lights in view: the player's camera (fov 75°, 16:10) at eye height on
##      every navmesh polygon, turned to 16 headings and 3 pitches; the most
##      lights any view touches, and where;
##   2. lights per mesh: for every visible mesh, how many lights reach it;
##   3. light on the guards' routes: the omni light reaching a guard's chest
##      (1.2 m) every 0.5 m along every patrol leg, with Godot's own omni
##      attenuation and no occlusion (the level's omni lights cast no shadows, so
##      walls don't block them), from the lights above the chest (a light below
##      it, on the floor beneath, only reaches a guard's downward faces); plus
##      the ambient light, which is the same everywhere. Even light on the routes
##      means no guard walks into a dark patch (where it would be hard to see) or
##      a hot spot.
## Nothing in the level is changed.

const SCENE := "res://scenes/level/expanded_library.tscn"
const Layout := preload("res://tools/expanded/expanded_layout.gd")
const EYE := 1.6
const FOV := 75.0
const ASPECT := 1.6
const CHEST := 1.2

var _root: Node3D
var _lights := []   # [name, position, range, energy, decay, fade end (INF: no fade), cull mask]


func _init() -> void:
	var out := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--out="):
			out = a.trim_prefix("--out=")
	_root = (load(SCENE) as PackedScene).instantiate()
	var max_view: int = ProjectSettings.get_setting("rendering/limits/opengl/max_renderable_lights", 32)
	var max_object: int = ProjectSettings.get_setting("rendering/limits/opengl/max_lights_per_object", 8)
	_collect(_root)
	var md := PackedStringArray()
	md.append("# Expanded Library — lighting report (layout %s)\n" % Layout.VERSION)
	md.append("Generated by `tools/expanded/light_report.gd`. %d positional lights (omni, no shadows). Renderer limits: %d lights in view, %d per mesh.\n" % [_lights.size(), max_view, max_object])
	# 1. Lights in view.
	var nav: NavigationMesh = (_root.get_node("NavigationRegion3D") as NavigationRegion3D).navigation_mesh
	var points := _polygon_centres(nav)
	var worst := 0
	var worst_at := ""
	var histogram := {}
	var views := 0
	for p in points:
		for h in 16:
			for pitch in [-25.0, 0.0, 25.0]:
				var n := _lights_in_view(p + Vector3(0, EYE, 0), h * TAU / 16.0, deg_to_rad(pitch))
				views += 1
				histogram[n] = histogram.get(n, 0) + 1
				if n > worst:
					worst = n
					worst_at = "(%.1f, %.1f, %.1f) heading %d°, pitch %d°" % [p.x, p.y, p.z, h * 360 / 16, pitch]
	var over_view := 0
	for n in histogram:
		if n > max_view:
			over_view += histogram[n]
	md.append("## 1. Lights in view\n")
	md.append("%d views (camera at eye height on all %d navmesh polygons × 16 headings × 3 pitches). Most lights touching one view: **%d** (limit %d), at %s. Views over the limit: **%d**.\n" % [
		views, points.size(), worst, max_view, worst_at, over_view])
	var keys := histogram.keys()
	keys.sort()
	var buckets := {}
	for n in keys:
		var b: int = int(n / 4) * 4
		buckets[b] = buckets.get(b, 0) + histogram[n]
	md.append("| Lights in view | Views |\n|---|---|")
	for b in buckets:
		md.append("| %d–%d | %d |" % [b, b + 3, buckets[b]])
	md.append("")
	# 2. Lights per mesh.
	var meshes := []
	_meshes(_root, meshes)
	var over_object := []
	var per_mesh := {}
	for m in meshes:
		var box: AABB = m[1]
		var n := 0
		for l in _lights:
			# Godot pairs a light with a mesh when the light's bounding box (a cube
			# of its range) meets the mesh's and the light's cull mask includes one
			# of the mesh's layers; the cube is counted here, to be safe.
			if (l[6] & m[2]) != 0 and AABB(l[1] - Vector3.ONE * l[2], Vector3.ONE * l[2] * 2.0).intersects(box):
				n += 1
		per_mesh[n] = per_mesh.get(n, 0) + 1
		if n > max_object:
			over_object.append("%s (%d)" % [m[0], n])
	md.append("## 2. Lights per mesh\n")
	md.append("%d meshes (the books, built when the level loads, follow their bookcases). A light counts for a mesh when its range's bounding cube meets the mesh and its cull mask includes the mesh's layers (how Godot pairs them). Meshes reached by more than %d lights: **%d**%s\n" % [meshes.size(), max_object, over_object.size(),
		(": " + ", ".join(over_object.slice(0, 12)) + (" …" if over_object.size() > 12 else "")) if over_object.size() > 0 else "."])
	var mk := per_mesh.keys()
	mk.sort()
	md.append("| Lights reaching the mesh | Meshes |\n|---|---|")
	for n in mk:
		md.append("| %d | %d |" % [n, per_mesh[n]])
	md.append("")
	# 3. Light on the guards' routes.
	md.append("## 3. Light on the guards' routes\n")
	var env: Environment = (_root.get_node("WorldEnvironment") as WorldEnvironment).environment
	md.append("Omni light at a guard's chest (%.1f m) from the lights above it, every 0.5 m along each patrol leg on one floor (legs that change floors are left out). Ambient light everywhere: %.2f; the total is ambient + omni. Light units: Godot's omni energy × attenuation (a fixture 3 m away gives about 0.4).\n" % [CHEST, env.ambient_light_energy])
	md.append("| Route | Samples | Min | Median | Max | Total min / median / max | Lights reaching (max) |\n|---|---|---|---|---|---|---|")
	var overall_min := INF
	var overall_at := ""
	for p in Layout.PATROLS:
		var samples: Array[float] = []
		var most := 0
		for k in p.points.size():
			var a := Layout.patrol_point(p, k)
			var b := Layout.patrol_point(p, (k + 1) % p.points.size())
			if not is_equal_approx(a.y, b.y):
				continue
			var steps := maxi(1, int(a.distance_to(b) / 0.5))
			for s in steps:
				var at := a.lerp(b, float(s) / steps) + Vector3(0, CHEST, 0)
				var res := _light_at(at)
				samples.append(res[0])
				most = maxi(most, res[1])
				if res[0] < overall_min:
					overall_min = res[0]
					overall_at = "%s at (%.1f, %.1f, %.1f)" % [p.id, at.x, at.y - CHEST, at.z]
		samples.sort()
		if samples.is_empty():
			continue
		var amb := env.ambient_light_energy
		md.append("| %s %s%s | %d | %.2f | %.2f | %.2f | %.2f / %.2f / %.2f | %d |" % [p.id, p.name, "" if p.has("guard") else " (no guard)", samples.size(),
			samples[0], samples[samples.size() / 2], samples[-1], amb + samples[0], amb + samples[samples.size() / 2], amb + samples[-1], most])
	md.append("\nDarkest point on any route: %.2f, %s.\n" % [overall_min, overall_at])
	var text := "\n".join(md)
	print(text)
	if out != "":
		var f := FileAccess.open(out if out.is_absolute_path() else ProjectSettings.globalize_path("res://" + out), FileAccess.WRITE)
		f.store_string(text)
		f.close()
	_root.free()
	quit(0)


func _collect(node: Node) -> void:
	if node is OmniLight3D and (node as OmniLight3D).visible:
		var l := node as OmniLight3D
		var fade_end := l.distance_fade_begin + l.distance_fade_length if l.distance_fade_enabled else INF
		_lights.append([String(_root.get_path_to(l)), _global(l).origin, l.omni_range, l.light_energy, l.omni_attenuation, fade_end, l.light_cull_mask])
	for c in node.get_children():
		_collect(c)


func _meshes(node: Node, out: Array) -> void:
	if node is GeometryInstance3D and node.get("mesh") != null or node is MultiMeshInstance3D:
		var gi := node as GeometryInstance3D
		# BatchedBoxes know their bounds without a renderer (a headless run has none).
		var box: AABB = _global(gi) * (gi.call("local_aabb") if gi.has_method("local_aabb") else gi.get_aabb())
		out.append([String(_root.get_path_to(gi)), box, gi.layers])
	if node.name in ["Player", "Guards", "Layout"] and node.get_parent() == _root:
		return
	for c in node.get_children():
		_meshes(c, out)


func _global(node: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var n := node
	while n and n != _root:
		if n is Node3D:
			t = (n as Node3D).transform * t
		n = n.get_parent()
	return t


func _polygon_centres(nav: NavigationMesh) -> Array[Vector3]:
	var v := nav.get_vertices()
	var out: Array[Vector3] = []
	for i in nav.get_polygon_count():
		var c := Vector3.ZERO
		var poly := nav.get_polygon(i)
		for k in poly:
			c += v[k]
		out.append(c / poly.size())
	return out


## Lights whose range touches the view frustum of a camera at `eye`, heading `yaw`, `pitch`.
func _lights_in_view(eye: Vector3, yaw: float, pitch: float) -> int:
	var basis := Basis(Vector3.UP, yaw) * Basis(Vector3.RIGHT, pitch)
	var forward := -basis.z
	var half_v := deg_to_rad(FOV / 2.0)
	var half_h := atan(tan(half_v) * ASPECT)
	# Inward normals of the four side planes and the near plane, all through the eye.
	var normals := [
		(basis * Vector3(cos(half_h), 0, -sin(half_h))).normalized(),    # left plane
		(basis * Vector3(-cos(half_h), 0, -sin(half_h))).normalized(),   # right plane
		(basis * Vector3(0, -cos(half_v), -sin(half_v))).normalized(),   # top plane
		(basis * Vector3(0, cos(half_v), -sin(half_v))).normalized(),    # bottom plane
		forward]
	var n := 0
	for l in _lights:
		if eye.distance_to(l[1]) > l[5]:
			continue   # faded out: takes no slot
		var inside := true
		for nn in normals:
			if (l[1] - eye).dot(nn) < -l[2]:
				inside = false
				break
		if inside:
			n += 1
	return n


func _sphere_box(centre: Vector3, radius: float, box: AABB) -> bool:
	var closest := centre.clamp(box.position, box.end)
	return closest.distance_to(centre) <= radius


## [omni light reaching `at`, number of lights in range], Godot's omni attenuation.
func _light_at(at: Vector3) -> Array:
	var total := 0.0
	var n := 0
	for l in _lights:
		var d: float = at.distance_to(l[1])
		if d >= l[2] or l[1].y < at.y:
			continue
		n += 1
		var nd: float = pow(d / l[2], 4.0)
		var att: float = pow(maxf(1.0 - nd, 0.0), 2.0) * pow(maxf(d, 0.0001), -l[4])
		total += l[3] * att
	return [total, n]
